## Interface: 120100
## Title: Ka0s KickCD
## Notes: Tracks interrupt + CC cooldowns on a movable icon grid.
## Author: add1kted2ka0s
## Version: 1.3.0
## IconTexture: Interface\AddOns\KickCD\media\logos\kickcd.logo.128.tga
## SavedVariables: KickCDDB, KickCDPerfDB
## OptionalDeps: Ace3, LibStub, CallbackHandler-1.0, LibSharedMedia-3.0, LibDataBroker-1.1, LibDBIcon-1.0
## DefaultState: enabled
## Category-enUS: Combat
## X-License: MIT
## X-Standard: https://github.com/tusharsaxena/WowAddonStandards
## X-Curse-Project-ID: 1530802
# ## X-Wago-ID is absent deliberately: toc-file-§1 makes a distribution id mandatory
# only for a platform the addon actually ships on, and this addon is CurseForge-only.
# Add the line if and when it is listed on Wago; do not commit a placeholder.

# Libraries (must load first)
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.lua
libs\AceAddon-3.0\AceAddon-3.0.lua
libs\AceEvent-3.0\AceEvent-3.0.lua
libs\AceDB-3.0\AceDB-3.0.lua
libs\AceDBOptions-3.0\AceDBOptions-3.0.lua
libs\AceConsole-3.0\AceConsole-3.0.lua
libs\AceGUI-3.0\AceGUI-3.0.xml
libs\AceConfig-3.0\AceConfig-3.0.xml
libs\LibKa0s\LibKa0s.xml
libs\LibSharedMedia-3.0\lib.xml
libs\AceGUI-3.0-SharedMediaWidgets\widget.xml
libs\LibCustomGlow-1.0\LibCustomGlow-1.0.xml
# The launcher's two libraries (launcher-§1). LibDataBroker-1.1 first: it is
# what LibDBIcon-1.0 reads the object out of, and both need CallbackHandler-1.0
# above. core\LauncherSetup.lua is the one caller and resolves each with
# LibStub(..., true), so a host missing either degrades rather than raising.
libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
libs\LibDBIcon-1.0\LibDBIcon-1.0.lua

# Locales
# Conventional position: read through NS.L at call time; free within the block.
locales\enUS.lua

# Core
# A line in this block without a LOAD-BEARING POSITION comment is conventional:
# free to move within the block.
core\Compat.lua
# The LibKa0s-Env seam: this addon's own version, read from its TOC manifest.
# After Compat; nothing here resolves at load, so this line is free to move.
core\EnvSetup.lua
# The LibKa0s-Pool-1.0 seam. Anywhere after the libs block and before
# modules\IconGrid.lua, which is its only caller.
core\PoolSetup.lua
# LOAD-BEARING POSITION: core/Constants.lua resolves Const.FONT_MONO from
# NS.MediaFont at file load, so the LibKa0s-Media-1.0 seam must already be
# published. This line moves only with that one.
core\MediaSetup.lua
core\Constants.lua
core\State.lua
core\Util.lua
# LOAD-BEARING POSITION: this file hangs the secret-safe printer on NS.Util as
# NS.Util.print, and core/Util.lua assigns NS.Util a FRESH table unconditionally.
# Above that line the printer is replaced rather than merged, and every one of the
# ~20 call sites reads it as `NS.Util and NS.Util.print` — so the addon goes
# silent instead of raising. The `NS.Util = NS.Util or {}` at the head of this
# file survives the reversed order without an error, which is what makes the
# order worth stating here rather than only in the file.
core\CoreSetup.lua
core\DebugLogSetup.lua
core\Units.lua
core\Database.lua
core\KickCD.lua
# LOAD-BEARING POSITION: calls NS.NewBusTarget (core/KickCD.lua) at file load;
# everything else it reads resolves at call time.
core\SpellInput.lua
# The LibKa0s-Launcher-1.0 seam. Anywhere in this block: nothing resolves at
# load beyond LibStub, and the click handlers reach NS.ToggleLock and
# NS:OpenSettings at CALL time. Here, below core\KickCD.lua, only so a reader
# meets the switch the left button drives before the button that drives it.
core\LauncherSetup.lua
# The LibKa0s-Lifecycle-1.0 seam: the stand-down latch both `disable` and the
# perf harness take a hold on (slash-commands-§7). ABOVE core\PerfSetup.lua,
# which passes NS.Lifecycle into its descriptor at LOAD time and raises at :New
# without it, and below core\CoreSetup.lua for NS.Util.print. Everything else it
# touches -- the modules it stands down -- it resolves at call time.
core\LifecycleSetup.lua
# LOAD-BEARING POSITION: modules/Cooldowns.lua, modules/IconGrid.lua,
# modules/IconGrid_Render.lua and modules/Castbar.lua each take
# `local Perf = NS.Perf` at file scope, so this seam must have published NS.Perf
# — the LibKa0s-Perf-1.0 instance or its stub — before the # Modules block is
# reached. It is also below core/KickCD.lua because the descriptor's `version`
# falls back to NS.VERSION, which that file sets; above it every capture record
# stamped "v?" (performance-§8). LAST in this block satisfies both.
core\PerfSetup.lua

# Defaults (the only place a profile default is hardcoded — savedvariables-§2)
# Conventional position: read at call time by core/Database.lua aceDBDefaults;
# free within the block.
defaults\Profile.lua
defaults\Spells.lua

# Modules
# Conventional position: the four parent modules (Cooldowns, IconGrid, Castbar,
# UnitLabel) are free relative to each other. Their siblings are not; see below.
modules\Cooldowns.lua
modules\IconGrid.lua
# LOAD-BEARING POSITION: modules/IconGrid_Layout.lua and modules/IconGrid_Render.lua
# call NS:GetModule("IconGrid") at file scope, so both follow modules\IconGrid.lua.
modules\IconGrid_Layout.lua
modules\IconGrid_Render.lua
modules\Castbar.lua
# LOAD-BEARING POSITION: modules/Castbar_Handle.lua, modules/Castbar_Skin.lua,
# modules/Castbar_Events.lua and modules/Castbar_Debug.lua call NS:GetModule("Castbar")
# at file scope, so all four follow modules\Castbar.lua.
modules\Castbar_Handle.lua
modules\Castbar_Skin.lua
modules\Castbar_Events.lua
modules\Castbar_Debug.lua
modules\UnitLabel.lua
# The sections of `/kcd diagnostics` (debug-logging-§14). Last in this block by
# convention only: every module it reads it resolves at CALL time, when the
# report runs, and core\DebugLogSetup.lua asks it for its sections the same way.
modules\Diagnostics.lua

# Settings (last — depend on everything else being initialized)
# LOAD-BEARING POSITION: creates NS.Settings.Schema (the rows array) and NS.Settings.Store, which both descriptors and every page file's add/AddComposed reach at load
settings\SchemaSetup.lua
settings\Slash.lua
# LOAD-BEARING POSITION: this file creates NS.Settings and publishes the
# LibKa0s-Options-1.0 instance on it as NS.Settings.Helpers. settings/Panel.lua,
# settings/Panel_Widgets.lua, settings/Panel_Render.lua and the page and entry files
# General/Icons/Castbar/Label/Grid all take that member as a file-scope upvalue, and
# General and Icons then CALL H.AddComposed at file scope — so a position below
# any of them raises during load, not on first open.
settings\OptionsSetup.lua
# LOAD-BEARING POSITION: this file DECORATES the Helpers instance in place with
# the members that did not generalize into the library — Helpers.AddComposed,
# Helpers.AnchorValues and Helpers.LSMValues among them. settings/General.lua,
# settings/Icons.lua and settings/Castbar.lua call AddComposed at file scope, and
# settings/Icons.lua and settings/Castbar.lua resolve AnchorValues into a
# file-scope local, so this line must stay above every per-tab file.
settings\Panel.lua
# Conventional position: below settings\Panel.lua the page files are free relative to
# each other, bar two notes: settings\Grid.lua's and settings\Spells_Rows.lua's. The
# Icons, Cast bar and Text Label files call Helpers.RegisterGridSection, which
# settings\Panel_Render.lua publishes, at file scope, so they stay below it.
settings\Panel_Widgets.lua
settings\Panel_Render.lua
settings\General.lua
settings\Icons.lua
settings\Castbar.lua
settings\Label.lua
# LOAD-BEARING POSITION: the Grid page (KickCD#33) registers here, and page order is
# registration order, so the tree reads General, Grid, Spells, Profiles. It binds the
# entries settings\Icons.lua, Castbar.lua and Label.lua registered above it.
settings\Grid.lua
settings\Spells.lua
# LOAD-BEARING POSITION: takes NS.Settings.SpellsPanel (settings/Spells.lua) as a file-scope upvalue.
settings\Spells_Rows.lua
settings\Profiles.lua
